# Living Code for delta. Maintained in this repository.
# Syntax colors come from the matching tmTheme; install it into bat first.

[delta "living-code-night"]
	dark = true
	syntax-theme = "living-code-night"
	minus-style = "syntax #1a1214"
	minus-non-emph-style = "syntax #1a1214"
	minus-emph-style = "bold syntax #371f1f"
	minus-empty-line-marker-style = "normal #1a1214"
	plus-style = "syntax #101a17"
	plus-non-emph-style = "syntax #101a17"
	plus-emph-style = "bold syntax #213227"
	plus-empty-line-marker-style = "normal #101a17"
	zero-style = "syntax"
	whitespace-error-style = "reverse #e96560"
	line-numbers-minus-style = "#e96560"
	line-numbers-plus-style = "#8acb83"
	line-numbers-zero-style = "#50565b"
	line-numbers-left-style = "#1d2226"
	line-numbers-right-style = "#1d2226"
	file-style = "bold #e2e9ee"
	file-decoration-style = "#00a692 ul"
	hunk-header-style = "file line-number syntax"
	hunk-header-decoration-style = "#1d2226 box"
	hunk-header-file-style = "#80b6d3"
	hunk-header-line-number-style = "#f0be6d"
	commit-style = "bold #00a692"
	commit-decoration-style = "#00a692 box"
	blame-palette = "#05080b #090e11 #12171a #1d2226"
	blame-code-style = "syntax"
	inline-hint-style = "#747c80"
	grep-file-style = "#00a692"
	grep-line-number-style = "#f0be6d"
	grep-match-line-style = "syntax #12171a"
	grep-match-word-style = "bold #05080b #f0be6d"
	merge-conflict-ours-diff-header-style = "bold #f0be6d"
	merge-conflict-ours-diff-header-decoration-style = "#1d2226 box"
	merge-conflict-theirs-diff-header-style = "bold #80b6d3"
	merge-conflict-theirs-diff-header-decoration-style = "#1d2226 box"

